{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pose Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "frame_id", "timestamp_ms", "width", "height", "status", "landmarks"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "frame_id": {"type": "string", "minLength": 1},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["detected", "no_pose", "error"]},
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "x", "y", "z", "visibility"],
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 32},
          "x": {"type": "number", "minimum": 0, "maximum": 1},
          "y": {"type": "number", "minimum": 0, "maximum": 1},
          "z": {"type": "number"},
          "visibility": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "error": {"type": "string"}
  }
}
